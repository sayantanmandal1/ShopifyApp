# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shopify_insights
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopify_insights

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=24h
BCRYPT_SALT_ROUNDS=12

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key-change-this

# Session Configuration
SESSION_TTL=86400

# Cache Configuration
CACHE_TTL_METRICS=300
CACHE_TTL_CUSTOMERS=900
CACHE_TTL_PRODUCTS=1800
CACHE_TTL_ORDERS=600

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Shopify API Configuration
SHOPIFY_API_VERSION=2024-01

# Job Queue Configuration
JOB_QUEUE_CONCURRENCY=5
JOB_QUEUE_MAX_RETRIES=3

# Logging
LOG_LEVEL=info
